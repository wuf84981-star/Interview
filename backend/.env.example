# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 排除，请勿提交。

# ---- LLM（任意 OpenAI 兼容接口）----
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-填入你自己的key
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=30

# 1 = 使用内置规则化 Mock 模型（无需任何 Key 即可演示完整链路）；0 = 调用真实模型
LLM_MOCK=0

# ---- Agent 循环 ----
# 单轮对话内最多的「决策 + 工具」步数
MAX_STEPS=5

# ---- 上下文预算 ----
CONTEXT_CHAR_BUDGET=6000
KEEP_RECENT_MESSAGES=8
SUMMARY_MAX_CHARS=600

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
